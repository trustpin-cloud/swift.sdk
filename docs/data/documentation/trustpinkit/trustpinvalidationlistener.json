h:"},{"type":"text","text":" "},{"type":"text","text":"verdicts served from the SDK’s internal cache do not re-notify. A"},{"text":" ","type":"text"},{"text":"configuration refresh clears that cache, after which re-evaluation","type":"text"},{"type":"text","text":" "},{"text":"re-notifies.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Global listener","type":"text"}]},{"text":": one listener serves all instances; ","type":"text"},{"type":"codeVoice","code":"instanceId"},{"text":" ","type":"text"},{"text":"attributes every callback. ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" detaches."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Threading","type":"text"}]},{"type":"text","text":": delivered synchronously from SDK internals, including"},{"text":" ","type":"text"},{"text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"don’t send inline) and must not call back into TrustPin."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"presentedCertificate","type":"codeVoice"},{"text":" is the DER-encoded leaf certificate as received","type":"text"},{"text":" ","type":"text"},{"text":"from the network — ","type":"text"},{"inlineContent":[{"type":"text","text":"attacker-supplied data"}],"type":"strong"},{"text":". Sanitize before","type":"text"},{"text":" ","type":"text"},{"text":"rendering or forwarding to a backend.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"topicSections":[{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationLis