{"seeAlsoSections":[{"title":"Observing","anchor":"Observing","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogLevel","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogSink","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinClosureLogSink"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrustPinValidationListener","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When TrustPin detects a pin mismatch — potentially an active"},{"type":"text","text":" "},{"type":"text","text":"machine-in-the-middle — the connection fails, but without a listener"},{"type":"text","text":" "},{"type":"text","text":"neither the app nor its backend ever learns a MITM was detected in the"},{"type":"text","text":" "},{"type":"text","text":"field. The listener is that observability hook: field telemetry for"},{"type":"text","text":" "},{"type":"text","text":"suspected MITM events, and rollout monitoring (success\/failure ratios per"},{"type":"text","text":" "},{"type":"text","text":"domain before tightening policy)."}],"type":"paragraph"},{"level":2,"text":"Observe-only, by construction","anchor":"Observe-only-by-construction","type":"heading"},{"inlineContent":[{"type":"text","text":"The listener is invoked strictly "},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"type":"text","text":" the verdict is decided. It has no"},{"type":"text","text":" "},{"type":"text","text":"return value and cannot veto, approve, or alter a connection — hooking or"},{"type":"text","text":" "},{"type":"text","text":"replacing it can at most blind telemetry, never weaken pinning."}],"type":"paragraph"},{"level":2,"text":"Contract","anchor":"Contract","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"fires exclusively for definitive pin verdicts:"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired","type":"reference"},{"type":"text","text":", and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","type":"reference"},{"type":"text","text":" (strict mode). Transient"},{"type":"text","text":" "},{"type":"text","text":"conditions — configuration fetch failures, timeouts, lifecycle errors —"},{"type":"text","text":" "},{"type":"text","text":"still fail verification per the documented error contract but are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)","type":"reference"},{"type":"text","text":" fires when pins matched on a"},{"type":"text","text":" "},{"type":"text","text":"registered domain. Permissive-mode connections to unregistered domains"},{"type":"text","text":" "},{"type":"text","text":"produce no callback (no pin verdict was made). IP literals in strict"},{"type":"text","text":" "},{"type":"text","text":"mode report "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"At most one callback per evaluation","type":"text"}]},{"type":"text","text":" on the TLS-handshake path:"},{"type":"text","text":" "},{"type":"text","text":"verdicts served from the SDK’s internal cache do not re-notify. A"},{"type":"text","text":" "},{"type":"text","text":"configuration refresh clears that cache, after which re-evaluation"},{"type":"text","text":" "},{"type":"text","text":"re-notifies."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Global listener","type":"text"}]},{"type":"text","text":": one listener serves all instances; "},{"type":"codeVoice","code":"instanceId"},{"type":"text","text":" "},{"type":"text","text":"attributes every callback. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" detaches."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Threading","type":"text"}]},{"type":"text","text":": delivered synchronously from SDK internals, including"},{"type":"text","text":" "},{"type":"text","text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,"},{"type":"text","text":" "},{"type":"text","text":"don’t send inline) and must not call back into TrustPin."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"presentedCertificate"},{"type":"text","text":" is the DER-encoded leaf certificate as received"},{"type":"text","text":" "},{"type":"text","text":"from the network — "},{"type":"strong","inlineContent":[{"text":"attacker-supplied data","type":"text"}]},{"type":"text","text":". Sanitize before"},{"type":"text","text":" "},{"type":"text","text":"rendering or forwarding to a backend."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identif