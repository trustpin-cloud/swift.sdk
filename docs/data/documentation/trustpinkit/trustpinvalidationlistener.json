{"abstract":[{"text":"Observe-only telemetry hook for pin-validation verdicts.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/trustpinkit\/trustpinvalidationlistener"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Observing","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogLevel","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogSink","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinClosureLogSink"],"anchor":"Observing"}],"metadata":{"externalID":"s:11TrustPinKit0aB18ValidationListenerP","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"TrustPinValidationListener"}],"title":"TrustPinValidationListener","modules":[{"name":"TrustPinKit"}],"role":"symbol","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"}]},"hierarchy":{"paths":[["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit"]]},"sections":[],"identifier":{"url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"],"anchor":"Instance-Methods"}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/cloud.trustpin.swift\/s8SendableP","doc:\/\/cloud.trustpin.swift\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrustPinValidationListener","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"When TrustPin detects a pin mismatch — potentially an active","type":"text"},{"text":" ","type":"text"},{"text":"machine-in-the-middle — the connection fails, but without a listener","type":"text"},{"text":" ","type":"text"},{"text":"neither the app nor its backend ever learns a MITM was detected in the","type":"text"},{"text":" ","type":"text"},{"text":"field. The listener is that observability hook: field telemetry for","type":"text"},{"text":" ","type":"text"},{"text":"suspected MITM events, and rollout monitoring (success\/failure ratios per","type":"text"},{"text":" ","type":"text"},{"text":"domain before tightening policy).","type":"text"}]},{"type":"heading","level":2,"anchor":"Observe-only-by-construction","text":"Observe-only, by construction"},{"type":"paragraph","inlineContent":[{"text":"The listener is invoked strictly ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" the verdict is decided. It has no","type":"text"},{"text":" ","type":"text"},{"text":"return value and cannot veto, approve, or alter a connection — hooking or","type":"text"},{"text":" ","type":"text"},{"text":"replacing it can at most blind telemetry, never weaken pinning.","type":"text"}]},{"type":"heading","level":2,"anchor":"Contract","text":"Contract"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"fires exclusively for definitive pin verdicts:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired","type":"reference","isActive":true},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","type":"reference","isActive":true},{"text":" (strict mode). Transient","type":"text"},{"type":"text","text":" "},{"type":"text","text":"conditions — configuration fetch failures, timeouts, lifecycle errors —"},{"type":"text","text":" "},{"type":"text","text":"still fail verification per the documented error contract but are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)","isActive":true},{"type":"text","text":" fires when pins matched on a"},{"type":"text","text":" "},{"type":"text","text":"registered domain. Permissive-mode connections to unregistered domains"},{"type":"text","text":" "},{"type":"text","text":"produce no callback (no pin verdict was made). IP literals in strict"},{"type":"text","text":" "},{"type":"text","text":"mode report "},{"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"At most one callback per evaluation","type":"text"}]},{"type":"text","text":" on the TLS-handshake path:"},{"type":"text","text":" "},{"type":"text","text":"verdicts served from the SDK’s internal cache do not re-notify. A"},{"type":"text","text":" "},{"type":"text","text":"configuration refresh clears that cache, after which re-evaluation"},{"type":"text","text":" "},{"type":"text","text":"re-notifies."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Global listener"}]},{"text":": one listener serves all instances; ","type":"text"},{"code":"instanceId","type":"codeVoice"},{"type":"text","text":" "},{"text":"attributes every callback. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" detaches.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Threading"}]},{"type":"text","text":": delivered synchronously from SDK internals, including"},{"type":"text","text":" "},{"type":"text","text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,"},{"type":"text","text":" "},{"type":"text","text":"don’t send inline) and must not call back into TrustPin."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"presentedCertificate","type":"codeVoice"},{"text":" is the DER-encoded leaf certificate as received","type":"text"},{"text":" ","type":"text"},{"text":"from the network — ","type":"text"},{"inlineContent":[{"type":"text","text":"attacker-supplied data"}],"type":"strong"},{"text":". Sanitize before","type":"text"},{"text":" ","type":"text"},{"text":"rendering or forwarding to a backend.","type":"text"}]}]}]}],"kind":"content"}],"references":{"doc://cloud.trustpin.swift/documentation/TrustPinKit":{"kind":"symbol","url":"\/documentation\/trustpinkit","title":"TrustPinKit","type":"topic","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit","role":"collection","abstract":[{"text":"Certificate pinning for Apple platforms with a signed, remotely updated pin configuration.","type":"text"}]},"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinClosureLogSink":{"type":"t