{"abstract":[{"type":"text","text":"Observe-only telemetry hook for pin-validation verdicts."}],"sections":[],"identifier":{"url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit"]]},"seeAlsoSections":[{"generated":true,"title":"Observing","anchor":"Observing","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogLevel","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogSink","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinClosureLogSink"]}],"relationshipsSections":[{"identifiers":["doc:\/\/cloud.trustpin.swift\/s8SendableP","doc:\/\/cloud.trustpin.swift\/s16SendableMetatypeP"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trustpinkit\/trustpinvalidationlistener"]}],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"}],"roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"TrustPinValidationListener"}],"externalID":"s:11TrustPinKit0aB18ValidationListenerP","symbolKind":"protocol","title":"TrustPinValidationListener","role":"symbol","modules":[{"name":"TrustPinKit"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrustPinValidationListener","kind":"identifier"},{"kind":"text","text":" : AnyObject, "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"When TrustPin detects a pin mismatch — potentially an active","type":"text"},{"type":"text","text":" "},{"type":"text","text":"machine-in-the-middle — the connection fails, but without a listener"},{"type":"text","text":" "},{"type":"text","text":"neither the app nor its backend ever learns a MITM was detected in the"},{"type":"text","text":" "},{"type":"text","text":"field. The listener is that observability hook: field telemetry for"},{"type":"text","text":" "},{"type":"text","text":"suspected MITM events, and rollout monitoring (success\/failure ratios per"},{"text":" ","type":"text"},{"type":"text","text":"domain before tightening policy)."}]},{"level":2,"type":"heading","text":"Observe-only, by construction","anchor":"Observe-only-by-construction"},{"inlineContent":[{"type":"text","text":"The listener is invoked strictly "},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"type":"text","text":" the verdict is decided. It has no"},{"type":"text","text":" "},{"type":"text","text":"return value and cannot veto, approve, or alter a connection — hooking or"},{"type":"text","text":" "},{"type":"text","text":"replacing it can at most blind telemetry, never weaken pinning."}],"type":"paragraph"},{"type":"heading","text":"Contract","anchor":"Contract","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"fires exclusively for definitive pin verdicts:"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired"},{"type":"text","text":", and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered"},{"type":"text","text":" (strict mode). Transient"},{"type":"text","text":" "},{"type":"text","text":"conditions — configuration fetch failures, timeouts, lifecycle errors —"},{"type":"text","text":" "},{"type":"text","text":"still fail verification per the documented error contract but are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"},{"type":"text","text":" fires when pins matched on a"},{"type":"text","text":" "},{"type":"text","text":"registered domain. Permissive-mode connections to unregistered domains"},{"type":"text","text":" "},{"type":"text","text":"produce no callback (no pin verdict was made). IP literals in strict"},{"type":"text","text":" "},{"type":"text","text":"mode report "},{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"At most one callback per evaluation","type":"text"}]},{"text":" on the TLS-handshake path:","type":"text"},{"type":"text","text":" "},{"text":"verdicts served from the SDK’s internal cache do not re-notify. A","type":"text"},{"type":"text","text":" "},{"text":"configuration refresh clears that cache, after which re-evaluation","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-notifies."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Global listener"}]},{"text":": one listener serves all instances; ","type":"text"},{"type":"codeVoice","code":"instanceId"},{"text":" ","type":"text"},{"text":"attributes every callback. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" detaches.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Threading"}]},{"text":": delivered synchronously from SDK internals, including","type":"text"},{"text":" ","type":"text"},{"text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,","type":"text"},{"text":" ","type":"text"},{"text":"don’t send inline) and must not call back into TrustPin.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"presentedCertificate"},{"text":" is the DER-encoded leaf certificate as received","type":"text"},{"text":" ","type":"text"},{"text":"from the network — ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"attacker-supplied data"}]},{"text":". Sanitize before","type":"text"},{"type":"text","text":" "},{"type":"text","text":"rendering or forwarding to a backend."}],"type":"paragraph"}]}]}],"kind":"content"}],"references":{"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinErrors/pinsMismatch":{"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"pinsMismatch","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/trustpinkit\/trustpinerrors\/pinsmismatch","abstract":[{"type":"text","text":"The presented certificate does not match any configured pin for the domain."}],"identifier":"doc:\/\/cloud.trustpin.swift