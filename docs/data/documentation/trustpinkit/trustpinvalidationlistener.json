{"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/cloud.trustpin.swift\/s8SendableP","doc:\/\/cloud.trustpin.swift\/s16SendableMetatypeP"],"title":"Inherits From","type":"inheritsFrom"}],"hierarchy":{"paths":[["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit"]]},"abstract":[{"text":"Observe-only telemetry hook for pin-validation verdicts.","type":"text"}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"TrustPinValidationListener","kind":"identifier"}],"title":"TrustPinValidationListener","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"}],"externalID":"s:11TrustPinKit0aB18ValidationListenerP","roleHeading":"Protocol","modules":[{"name":"TrustPinKit"}],"role":"symbol","symbolKind":"protocol"},"variants":[{"paths":["\/documentation\/trustpinkit\/trustpinvalidationlistener"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"},{"kind":"text","text":" : AnyObject, "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When TrustPin detects a pin mismatch — potentially an active"},{"type":"text","text":" "},{"type":"text","text":"machine-in-the-middle — the connection fails, but without a listener"},{"type":"text","text":" "},{"type":"text","text":"neither the app nor its backend ever learns a MITM was detected in the"},{"text":" ","type":"text"},{"type":"text","text":"field. The listener is that observability hook: field telemetry for"},{"type":"text","text":" "},{"type":"text","text":"suspected MITM events, and rollout monitoring (success\/failure ratios per"},{"type":"text","text":" "},{"type":"text","text":"domain before tightening policy)."}],"type":"paragraph"},{"level":2,"anchor":"Observe-only-by-construction","text":"Observe-only, by construction","type":"heading"},{"inlineContent":[{"type":"text","text":"The listener is invoked strictly "},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"type":"text","text":" the verdict is decided. It has no"},{"type":"text","text":" "},{"type":"text","text":"return value and cannot veto, approve, or alter a connection — hooking or"},{"type":"text","text":" "},{"type":"text","text":"replacing it can at most blind telemetry, never weaken pinning."}],"type":"paragraph"},{"level":2,"anchor":"Contract","text":"Contract","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)"},{"type":"text","text":" "},{"type":"text","text":"fires exclusively for definitive pin verdicts:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered"},{"type":"text","text":" (strict mode). Transient"},{"type":"text","text":" "},{"type":"text","text":"conditions — configuration fetch failures, timeouts, lifecycle errors —"},{"type":"text","text":" "},{"type":"text","text":"still fail verification per the documented error contract but are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"},{"type":"text","text":" fires when pins matched on a"},{"type":"text","text":" "},{"type":"text","text":"registered domain. Permissive-mode connections to unregistered domains"},{"type":"text","text":" "},{"type":"text","text":"produce no callback (no pin verdict was made). IP literals in strict"},{"type":"text","text":" "},{"type":"text","text":"mode report "},{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"At most one callback per evaluation"}],"type":"strong"},{"type":"text","text":" on the TLS-handshake path:"},{"type":"text","text":" "},{"type":"text","text":"verdicts served from the SDK’s internal cache do not re-notify. A"},{"type":"text","text":" "},{"type":"text","text":"configuration refresh clears that cache, after which re-evaluation"},{"type":"text","text":" "},{"type":"text","text":"re-notifies."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Global listener"}],"type":"strong"},{"type":"text","text":": one listener serves all instances; "},{"type":"codeVoice","code":"instanceId"},{"type":"text","text":" "},{"type":"text","text":"attributes every callback. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" detaches."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Threading"}],"type":"strong"},{"type":"text","text":": delivered synchronously from SDK internals, including"},{"type":"text","text":" "},{"type":"text","text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,"},{"type":"text","text":" "},{"type":"text","text":"don’t send inline) and must not call back into TrustPin."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"presentedCertificate"},{"type":"text","text":" is the DER-encoded leaf certificate as received"},{"type":"text","text":" "},{"type":"text","text":"from the network — "},{"inlineContent":[{"type":"text","text":"attacker-supplied data"}],"type":"strong"},{"type":"text","text":". Sanitize before"},{"type":"text","text":" "},{"type":"text","text":"rendering or forwarding to a backend."}]}]}],"type":"unorderedList"}]}],"references":{"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinValidationListener":{"url":"\/documentation\/trustpinkit\/trustpinvalidationlistener","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrustPinValidationListener","kind":"identifier"}],"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener","navigatorTitle":[{"text":"TrustPinValidationListener","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Observe-only telemetry hook for pin-validation verdicts.","type":"text"}],"role":"symbol","title":"TrustPinValidationListener"},"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinErrors/allPinsExpired":{"title":"TrustPinErrors.allPinsExpired","fragments":[{"kind":