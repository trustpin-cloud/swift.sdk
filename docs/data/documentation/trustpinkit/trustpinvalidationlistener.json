{"abstract":[{"text":"Observe-only telemetry hook for pin-validation verdicts.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrustPinValidationListener","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"When TrustPin detects a pin mismatch — potentially an active","type":"text"},{"text":" ","type":"text"},{"text":"machine-in-the-middle — the connection fails, but without a listener","type":"text"},{"text":" ","type":"text"},{"text":"neither the app nor its backend ever learns a MITM was detected in the","type":"text"},{"text":" ","type":"text"},{"text":"field. The listener is that observability hook: field telemetry for","type":"text"},{"text":" ","type":"text"},{"text":"suspected MITM events, and rollout monitoring (success\/failure ratios per","type":"text"},{"text":" ","type":"text"},{"text":"domain before tightening policy).","type":"text"}],"type":"paragraph"},{"level":2,"text":"Observe-only, by construction","anchor":"Observe-only-by-construction","type":"heading"},{"inlineContent":[{"text":"The listener is invoked strictly ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" the verdict is decided. It has no","type":"text"},{"text":" ","type":"text"},{"text":"return value and cannot veto, approve, or alter a connection — hooking or","type":"text"},{"text":" ","type":"text"},{"text":"replacing it can at most blind telemetry, never weaken pinning.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Contract","anchor":"Contract","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"fires exclusively for definitive pin verdicts:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","isActive":true,"type":"reference"},{"text":" (strict mode). Transient","type":"text"},{"text":" ","type":"text"},{"text":"conditions — configuration fetch failures, timeouts, lifecycle errors —","type":"text"},{"text":" ","type":"text"},{"text":"still fail verification per the documented error contract but are never","type":"text"},{"text":" ","type":"text"},{"text":"reported.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)","isActive":true,"type":"reference"},{"text":" fires when pins matched on a","type":"text"},{"text":" ","type":"text"},{"text":"registered domain. Permissive-mode connections to unregistered domains","type":"text"},{"text":" ","type":"text"},{"text":"produce no callback (no pin verdict was made). IP literals in strict","type":"text"},{"text":" ","type":"text"},{"text":"mode report ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"At most one callback per evaluation","type":"text"}],"type":"strong"},{"text":" on the TLS-handshake path:","type":"text"},{"text":" ","type":"text"},{"text":"verdicts served from the SDK’s internal cache do not re-notify. A","type":"text"},{"text":" ","type":"text"},{"text":"configuration refresh clears that cache, after which re-evaluation","type":"text"},{"text":" ","type":"text"},{"text":"re-notifies.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Global listener","type":"text"}],"type":"strong"},{"text":": one listener serves all instances; ","type":"text"},{"code":"instanceId","type":"codeVoice"},{"text":" ","type":"text"},{"text":"attributes every callback. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" detaches.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Threading","type":"text"}],"type":"strong"},{"text":": delivered synchronously from SDK internals, including","type":"text"},{"text":" ","type":"text"},{"text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,","type":"text"},{"text":" ","type":"text"},{"text":"don’t send inline) and must not call back into TrustPin.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"presentedCertificate","type":"codeVoice"},{"text":" is the DER-encoded leaf certificate as received","type":"text"},{"text":" ","type":"text"},{"text":"from the network — ","type":"text"},{"inlineContent":[{"text":"attacker-supplied data","type":"text"}],"type":"strong"},{"text":". Sanitize before","type":"text"},{"text":" ","type":"text"},{"text":"rendering or forwarding to a backend.","type":"text"}]}]}]}]}],"metadata":{"title":"TrustPinValidationListener","symbolKind":"protocol","role":"symbol","externalID":"s:11TrustPinKit0aB18ValidationListenerP","fragments":[{"text":"protocol","kind":"keyword"},{"t