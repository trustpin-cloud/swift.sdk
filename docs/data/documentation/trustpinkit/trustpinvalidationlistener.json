{"metadata":{"externalID":"s:11TrustPinKit0aB18ValidationListenerP","title":"TrustPinValidationListener","roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"TrustPinValidationListener"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"}],"modules":[{"name":"TrustPinKit"}],"role":"symbol","symbolKind":"protocol"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Observe-only telemetry hook for pin-validation verdicts."}],"topicSections":[{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener"},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/cloud.trustpin.swift\/s8SendableP","doc:\/\/cloud.trustpin.swift\/s16SendableMetatypeP"],"type":"inheritsFrom"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trustpinkit\/trustpinvalidationlistener"]}],"hierarchy":{"paths":[["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"},{"kind":"text","text":" : AnyObject, "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When TrustPin detects a pin mismatch — potentially an active","type":"text"},{"text":" ","type":"text"},{"text":"machine-in-the-middle — the connection fails, but without a listener","type":"text"},{"text":" ","type":"text"},{"text":"neither the app nor its backend ever learns a MITM was detected in the","type":"text"},{"text":" ","type":"text"},{"text":"field. The listener is that observability hook: field telemetry for","type":"text"},{"text":" ","type":"text"},{"text":"suspected MITM events, and rollout monitoring (success\/failure ratios per","type":"text"},{"text":" ","type":"text"},{"text":"domain before tightening policy).","type":"text"}]},{"anchor":"Observe-only-by-construction","type":"heading","level":2,"text":"Observe-only, by construction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The listener is invoked strictly "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" the verdict is decided. It has no"},{"type":"text","text":" "},{"type":"text","text":"return value and cannot veto, approve, or alter a connection — hooking or"},{"type":"text","text":" "},{"type":"text","text":"replacing it can at most blind telemetry, never weaken pinning."}]},{"anchor":"Contract","type":"heading","level":2,"text":"Contract"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)"},{"type":"text","text":" "},{"type":"text","text":"fires exclusively for definitive pin verdicts:"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered"},{"text":" (strict mode). Transient","type":"text"},{"text":" ","type":"text"},{"text":"conditions — configuration fetch failures, timeouts, lifecycle errors —","type":"text"},{"text":" ","type":"text"},{"text":"still fail verification per the documented error contract but are never","type":"text"},{"text":" ","type":"text"},{"text":"reported.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)","isActive":true,"type":"reference"},{"text":" fires when pins matched on a","type":"text"},{"text":" ","type":"text"},{"text":"registered domain. Permissive-mode connections to unregistered domains","type":"text"},{"text":" ","type":"text"},{"text":"produce no callback (no pin verdict was made). IP literals in strict","type":"text"},{"text":" ","type":"text"},{"text":"mode report ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"At most one callback per evaluation","type":"text"}],"type":"strong"},{"type":"text","text":" on the TLS-handshake path:"},{"type":"text","text":" "},{"type":"text","text":"verdicts served from the SDK’s internal cache do not re-notify. A"},{"type":"text","text":" "},{"type":"text","text":"configuration refresh clears that cache, after which re-evaluation"},{"type":"text","text":" "},{"type":"text","text":"re-notifies."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Global listener"}],"type":"strong"},{"type":"text","text":": one listener serves all instances; "},{"code":"instanceId","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"attributes every callback. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" detaches."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Threading"}],"type":"strong"},{"type":"text","text":": delivered synchronously from SDK internals, including"},{"type":"text","text":" "},{"type":"text","text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,"},{"type":"text","text":" "},{"type":"text","text":"don’t send inline) and must not call back into TrustPin."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"presentedCertificate"},{"type":"text","text":" is the DER-encoded leaf certificate as received"},{"type":"text","text":" "},{"type":"text","text":"from the network — "},{"inlineContent":[{"text":"attacker-supplied data","type":"text"}],"type":"strong"},{"type":"text","text":". Sanitize before"},{"type":"text","text":" "},{"type":"text","text":"rendering or forwarding to a backend."}]}]}],"type":"unorderedList"}]}],"references":{"doc://cloud.trustpin.swift/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/cloud.trustpin.swift\/s8SendableP"},"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinErrors/pinsMismatch":{"url":"\/documentation\/trustpinkit\/trustpinerrors\/pinsmismatch","kind":"symbol","abstract":[{"type":"text","text":"The presented certificate does not match any configured pin for the domain."}],"title":"TrustPinErrors.pinsMismatch","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"pinsMismatch"}],"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch","role":"symbol"},"doc://cloud.trustpin.swift/documentation/TrustPinKit":{"role":"collec