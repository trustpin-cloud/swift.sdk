{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit"]]},"sections":[],"abstract":[{"type":"text","text":"Observe-only telemetry hook for pin-validation verdicts."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener"},"metadata":{"symbolKind":"protocol","title":"TrustPinValidationListener","externalID":"s:11TrustPinKit0aB18ValidationListenerP","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"}],"navigatorTitle":[{"text":"TrustPinValidationListener","kind":"identifier"}],"modules":[{"name":"TrustPinKit"}],"roleHeading":"Protocol"},"topicSections":[{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"},{"kind":"text","text":" : AnyObject, "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When TrustPin detects a pin mismatch — potentially an active"},{"type":"text","text":" "},{"type":"text","text":"machine-in-the-middle — the connection fails, but without a listener"},{"type":"text","text":" "},{"type":"text","text":"neither the app nor its backend ever learns a MITM was detected in the"},{"type":"text","text":" "},{"type":"text","text":"field. The listener is that observability hook: field telemetry for"},{"type":"text","text":" "},{"type":"text","text":"suspected MITM events, and rollout monitoring (success\/failure ratios per"},{"type":"text","text":" "},{"type":"text","text":"domain before tightening policy)."}]},{"type":"heading","text":"Observe-only, by construction","anchor":"Observe-only-by-construction","level":2},{"type":"paragraph","inlineContent":[{"text":"The listener is invoked strictly ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" the verdict is decided. It has no","type":"text"},{"text":" ","type":"text"},{"text":"return value and cannot veto, approve, or alter a connection — hooking or","type":"text"},{"text":" ","type":"text"},{"text":"replacing it can at most blind telemetry, never weaken pinning.","type":"text"}]},{"type":"heading","text":"Contract","anchor":"Contract","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationFailure(instanceId:domain:error:presentedCertificate:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"fires exclusively for definitive pin verdicts:"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/pinsMismatch","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/allPinsExpired","type":"reference"},{"type":"text","text":", and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered","type":"reference"},{"type":"text","text":" (strict mode). Transient"},{"type":"text","text":" "},{"type":"text","text":"conditions — configuration fetch failures, timeouts, lifecycle errors —"},{"type":"text","text":" "},{"type":"text","text":"still fail verification per the documented error contract but are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener\/onValidationSuccess(instanceId:domain:)"},{"type":"text","text":" fires when pins matched on a"},{"type":"text","text":" "},{"type":"text","text":"registered domain. Permissive-mode connections to unregistered domains"},{"type":"text","text":" "},{"type":"text","text":"produce no callback (no pin verdict was made). IP literals in strict"},{"type":"text","text":" "},{"type":"text","text":"mode report "},{"type":"reference","isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors\/domainNotRegistered"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"At most one callback per evaluation","type":"text"}],"type":"strong"},{"text":" on the TLS-handshake path:","type":"text"},{"text":" ","type":"text"},{"text":"verdicts served from the SDK’s internal cache do not re-notify. A","type":"text"},{"text":" ","type":"text"},{"text":"configuration refresh clears that cache, after which re-evaluation","type":"text"},{"text":" ","type":"text"},{"text":"re-notifies.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Global listener","type":"text"}],"type":"strong"},{"type":"text","text":": one listener serves all instances; "},{"code":"instanceId","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"attributes every callback. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" detaches."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Threading","type":"text"}]},{"type":"text","text":": delivered synchronously from SDK internals, including"},{"type":"text","text":" "},{"type":"text","text":"TLS-handshake paths. Implementations must be non-blocking (enqueue,"},{"type":"text","text":" "},{"type":"text","text":"don’t send inline) and must not call back into TrustPin."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"presentedCertificate"},{"text":" is the DER-encoded leaf certificate as received","type":"text"},{"text":" ","type":"text"},{"text":"from the network — ","type":"text"},{"inlineContent":[{"type":"text","text":"attacker-supplied data"}],"type":"strong"},{"text":". Sanitize before","type":"text"},{"text":" ","type":"text"},{"text":"rendering or forwarding to a backend.","type":"text"}]}]}]}]}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/cloud.trustpin.swift\/s8SendableP","doc:\/\/cloud.trustpin.swift\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trustpinkit\/trustpinvalidationlistener"]}],"references":{"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinValidationListener":{"title":"TrustPinValidationListener","abstract":[{"type":"text","text":"Observe-only telemetry hook for pin-validation verdicts."}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinValidationListener"}],"navigatorTitle":[{"kind":"identifier","text":"TrustPinValidationListener"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener","url":"\/documentation\/trustpinkit\/trustpinvalidationlistener"},"doc://cloud.trustpin.swift/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/cloud.trustpin.swift\/s16SendableMetatype