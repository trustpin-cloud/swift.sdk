oll pinning out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework runs on iOS 15, macOS 13, watchOS 9, tvOS 15, Mac Catalyst 15 and visionOS 2, uses Swift concurrency throughout, and adds pinning to "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":", to Alamofire through the "},{"type":"codeVoice","code":"TrustPinKitAlamofire"},{"type":"text","text":" product, or system-wide through "},{"isActive":true,"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinURLProtocol","type":"reference"},{"type":"text","text":"."}]},{"text":"Getting started","level":2,"anchor":"Getting-started","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ship your project’s identifiers in "},{"code":"TrustPin-Info.plist","type":"codeVoice"},{"type":"text","text":", set the SDK up once at launch, and give your session a pinning delegate:"}]},{"syntax":"swift","type":"codeListing","code":["import TrustPinKit","","try await TrustPin.setup(.fromPlist())","","let session = URLSession(configuration: .default,","                         delegate: TrustPin.makeURLSessionDelegate(),","                         delegateQueue: nil)"]},{"type":"paragraph","inlineContent":[{"code":"TrustPin.setup(_:)","type":"codeVoice"},{"type":"text","text":" returns without waiting for the network; call "},{"code":"TrustPin\/awaitConfiguration(timeout:)","type":"codeVoice"},{"type":"text","text":" when you want to be sure a validated configuration is in place before the first pinned request."}]}]}],"identifier":{"url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trustpinkit"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"Certificate pinning for Apple platforms with a signed, remotely updated pin configurati