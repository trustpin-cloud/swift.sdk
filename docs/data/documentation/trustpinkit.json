{"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPin","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinConfiguration","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinMode"],"anchor":"Essentials","title":"Essentials"},{"title":"Integration","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinURLProtocol"],"anchor":"Integration"},{"title":"Observing","identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogLevel","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogSink","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinClosureLogSink","doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinValidationListener"],"anchor":"Observing"},{"identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinAttestationProvider"],"title":"App attestation hook","anchor":"App-attestation-hook"},{"identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors"],"title":"Errors","anchor":"Errors"},{"generated":true,"identifiers":["doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinKitResources"],"title":"Classes","anchor":"Classes"}],"variants":[{"paths":["\/documentation\/trustpinkit"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"TrustPinKit"}],"title":"TrustPinKit","externalID":"TrustPinKit","roleHeading":"Framework"},"abstract":[{"type":"text","text":"Certificate pinning for Apple platforms with a signed, remotely updated pin configuration."}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"TrustPinKit pins the TLS certificates your app accepts for the hosts you register in your TrustPin project. The pin configuration is signed with your project key and published for the SDK to fetch, so rotating a certificate never requires an app update. In "},{"code":"strict","type":"codeVoice"},{"type":"text","text":" mode a connection to a host whose certificate does not match, or to an unregistered host, is refused; "},{"code":"permissive","type":"codeVoice"},{"type":"text","text":" mode lets unregistered hosts through while you roll pinning out."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The framework runs on iOS 15, macOS 13, watchOS 9, tvOS 15, Mac Catalyst 15 and visionOS 2, uses Swift concurrency throughout, and adds pinning to ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":", to Alamofire through the ","type":"text"},{"code":"TrustPinKitAlamofire","type":"codeVoice"},{"text":" product, or system-wide through ","type":"text"},{"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinURLProtocol","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","anchor":"Getting-started","text":"Getting started","level":2},{"inlineContent":[{"text":"Ship your project’s identifiers in ","type":"text"},{"code":"TrustPin-Info.plist","type":"codeVoice"},{"text":", set the SDK up once at launch, and give your session a pinning delegate:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import TrustPinKit","","try await TrustPin.setup(.fromPlist())","","let session = URLSession(configuration: .default,","                         delegate: TrustPin.makeURLSessionDelegate(),","                         delegateQueue: nil)"]},{"type":"paragraph","inlineContent":[{"code":"TrustPin.setup(_:)","type":"codeVoice"},{"text":" returns without waiting for the network; call ","type":"text"},{"type":"codeVoice","code":"TrustPin\/awaitConfiguration(timeout:)"},{"text":" when you want to be sure a validated configuration is in place before the first pinned request.","type":"text"}]}],"kind":"content"}],"references":{"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinLogSink":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"TrustPinLogSink"}],"abstract":[{"type":"text","text":"Receives every log message the SDK emits, after per-instance level"},{"type":"text","text":" "},{"type":"text","text":"filtering."}],"url":"\/documentation\/trustpinkit\/trustpinlogsink","title":"TrustPinLogSink","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinLogSink","role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TrustPinLogSink"}]},"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPin":{"kind":"symbol","url":"\/documentation\/trustpinkit\/trustpin","title":"TrustPin","type":"topic","role":"symbol","abstract":[{"type":"text","text":"TrustPin SSL certificate pinning SDK for Apple platforms."}],"identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPin"}],"navigatorTitle":[{"kind":"identifier","text":"TrustPin"}]},"doc://cloud.trustpin.swift/documentation/TrustPinKit/TrustPinErrors":{"kind":"symbol","abstract":[{"type":"text","text":"Errors thrown by the TrustPin API."}],"url":"\/documentation\/trustpinkit\/trustpinerrors","identifier":"doc:\/\/cloud.trustpin.swift\/documentation\/TrustPinKit\/TrustPinErrors","title":"TrustPinErrors","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrustPinErrors"}],"navigatorTitle":[{"kind":"identifier","text":"TrustPinErrors"}],"type":"topic","role":"symbol"},"doc://cloud.trustpin.swift/documentation/TrustPinKit":{"type":"topic","abstract":[{"text":"