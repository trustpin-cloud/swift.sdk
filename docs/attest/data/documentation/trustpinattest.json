{"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttest","doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestConfiguration"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestState","doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestError"],"title":"State","anchor":"State"},{"identifiers":["doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestLogLevel","doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestLogSink","doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestClosureLogSink"],"title":"Logging","anchor":"Logging"},{"identifiers":["doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest\/TrustPinAttestResources"],"title":"Classes","anchor":"Classes","generated":true}],"abstract":[{"text":"App attestation for Apple platforms: prove that requests come from your genuine app on a genuine device.","type":"text"}],"hierarchy":{"paths":[[]]},"metadata":{"symbolKind":"module","modules":[{"name":"TrustPinAttest"}],"title":"TrustPinAttest","externalID":"TrustPinAttest","role":"collection","roleHeading":"Framework"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/cloud.trustpin.swift.attest\/documentation\/TrustPinAttest"},"kind":"symbol","primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TrustPinAttest uses Apple’s App Attest to attest a device key with the attestation verifier you run, renews short-lived tokens, and adds them to requests for the hosts you configure as the ","type":"text"},{"type":"codeVoice","code":"TrustPin-Attestation"},{"type":"text","text":" header. Your backend verifies the header and decides what an unattested request may do. The framework never blocks or fails your requests: when no token is available, the request is sent without the header."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It builds on "},{"type":"codeVoice","code":"TrustPinKit"},{"text":": set up certificate pinning first, because every call to your verifier is pinned by the ","type":"text"},{"type":"codeVoice","code":"TrustPin"},{"type":"text","text":" instance with the same identifier, and register the verifier’s domain in your TrustPin project. Tokens can be bound to the user’s session so that a token cannot be replayed outside it."}]},{"anchor":"Getting-started","type":"heading","text":"Getting started","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"AttestVerifierURL"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AttestedHosts"},{"type":"text","text":" to the "},{"type":"codeVoice","code":"TrustPin-Info.plist"},{"type":"text","text":" that holds your pinning configuration, then:"}]},{"type":"codeListing","syntax":"swift","code":["import TrustPinKit","import TrustPinAttest","","try await TrustPin.setup(.fromPlist())","try await TrustPinAttest.setup(.fromPlist())","","TrustPinAttest.bindToHeader(\"Authorization\")   \/\/ bind tokens to the session","TrustPinAttest.prefetch()                       \/\/ attest early","","\/\/ Requests through TrustPinURLProtocol or the Alamofire adapter get the header","\/\/ automatically. For your own URLSession:","var request = URLRequest(url: url)","request = await TrustPinAttest.addingAttestation(to: request)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simulators cannot run App Attest; your verifier’s operator can issue a debug token for development, set as "},{"type":"codeVoice","code":"TRUSTPIN_DEBUG_TOKEN"},{"type":"text","text":" in the scheme’s environment."}]}],"kind":"content"}],"variants":[{"traits":[{"interfac